# ---- Azure OpenAI (required) ----
AZURE_ENDPOINT=
AZURE_DEPLOYMENT=
AZURE_SUBSCRIPTION_KEY=
AZURE_API_VERSION=

# ---- Tavily (required, used by the news agent) ----
TAVILY_API_KEY=

# ---- Dynatrace AI Observability (optional) ----
# Tenant URL, the OTLP base, or the full traces URL - all are accepted:
#   https://<tenant>.live.dynatrace.com
#   https://<tenant>.live.dynatrace.com/api/v2/otlp
#   https://<tenant>.live.dynatrace.com/api/v2/otlp/v1/traces
DYNATRACE_EXPORTER_OTLP_ENDPOINT=
# Classic access token (dt0c01...) with scope openTelemetryTrace.ingest, or a
# platform token (dt0s...) with scope openpipeline:traces:ingest.
DYNATRACE_API_TOKEN=
# Service name shown in Dynatrace (defaults to FinancialAIAgent).
OTEL_SERVICE_NAME=

# ---- OpenInference options (optional) ----
# Emit OTel gen_ai.* attributes next to the native OpenInference ones.
# The app already enables this in code; set it only to turn it off.
OPENINFERENCE_ENABLE_GENAI_SEMCONV=true
# Prompt and completion content is captured by default. Set any of these to
# true to suppress it.
# OPENINFERENCE_HIDE_INPUTS=true
# OPENINFERENCE_HIDE_OUTPUTS=true
# OPENINFERENCE_HIDE_INPUT_MESSAGES=true
# OPENINFERENCE_HIDE_OUTPUT_MESSAGES=true
